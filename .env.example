# Docker/PostgreSQL development configuration
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=portfolio_rebalancer

# Backend configuration
DATABASE_URL=postgresql+psycopg://portfolio:replace-with-a-local-password@db:5432/portfolio_rebalancer
JWT_SECRET=replace-with-a-long-random-development-secret
APP_ENV=development
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MARKET_PRICE_CACHE_SECONDS=300

# Vite frontend configuration
VITE_API_BASE_URL=http://localhost:8000
